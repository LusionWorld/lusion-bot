# Discord OAuth2 — crie/edite em https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Local: http://localhost:3000/api/auth/callback
# Produção: https://<seu-dominio-vercel>/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Token do bot (mesmo do serviço do bot) — usado server-side para resolver
# nome/avatar de usuários e nome de canais/categorias nas telas do painel.
DISCORD_BOT_TOKEN=

# Segredo para assinar o cookie de sessão (gere uma string aleatória longa)
SESSION_SECRET=

# Supabase (projeto "lusion-bot")
SUPABASE_URL=https://blncskhonlpeoltulfoy.supabase.co
# Settings > API > service_role secret — NUNCA expor com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# API interna do bot (rede privada do Railway: http://<serviço>.railway.internal:<porta>).
# Local, sem Railway: rode o bot e use http://localhost:8090.
BOT_INTERNAL_URL=http://lusion-bot.railway.internal:8090
# Mesmo valor de INTERNAL_API_SECRET configurado no serviço do bot.
INTERNAL_API_SECRET=
